# The nightly backup of Hof (docs/OPERATIONS.md, section «Автоматические копии»).
[Unit]
Description=Hof: ночная резервная копия базы
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# A missed run starts right after boot: first wait for the containers to come up.
ExecStartPre=/usr/bin/sleep 120
ExecStart=/usr/local/sbin/hof-backup --timer
# A hung process must not hold the lock of the update for ever.
TimeoutStartSec=30min

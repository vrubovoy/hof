<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Забор резервных копий Hof на Mac (docs/OPERATIONS.md, раздел «Копия на Mac»). launchd не
     раскрывает ~, поэтому @HOME@ заменяется при установке. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>hof.backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>@HOME@/.local/bin/hof-backup-pull</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/hof-backup-pull.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/hof-backup-pull.log</string>
</dict>
</plist>

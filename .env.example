# Copy to .env, fill in every value and keep it private: chmod 600 .env.
# A password can be generated with: openssl rand -hex 24

# PostgreSQL superuser. Only the postgres container gets it, to create the roles on first start.
POSTGRES_PASSWORD=
# Login passwords of the module roles hof_core and hof_saeckel.
HOF_CORE_DB_PASSWORD=
HOF_SAECKEL_DB_PASSWORD=

# The installation (ARCHITECTURE.md §5.6, §9). Hof does not start without them.
# Currency of every amount in Säckel: an ISO 4217 code with two decimal places, e.g. RUB or EUR.
# It is fixed by the first record: after that Hof refuses to start with another one.
CURRENCY=
# Time zone of «today» for the date of a record: an IANA name, e.g. Europe/Moscow.
TZ=

# The one domain of Hof, e.g. hof.example.org (ARCHITECTURE.md §9). Only nginx and the certificate
# need it, not the application: without it postgres and hof run, as in development, and nginx is
# not created.
HOF_DOMAIN=

# Development only: compose.dev.yaml publishes PostgreSQL on 127.0.0.1:5433.
# Standard libpq variable, read by the pg driver of a locally started Hof and its tests.
PGPORT=5433
